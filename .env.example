# --- Required (pick ONE provider) -------------------------------------
# Path A (default — Strands-native): AWS Bedrock
# Either standard AWS creds…
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# …or a Bedrock API key (preferred for laptops; no IAM setup):
# AWS_BEARER_TOKEN_BEDROCK=

# Path B (lower-friction alternative): Anthropic API
# Just set this and the template auto-switches to AnthropicModel.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Default model -----------------------------------------------------
# Used by any agent that doesn't have a per-agent override below.
# Bedrock model ID by default; switch to a bare Anthropic ID if you
# enabled Path B above.
MODEL=anthropic.claude-sonnet-4-6-20250514-v1:0
# MODEL=claude-sonnet-4-6   # Anthropic API path

# --- Recommended -------------------------------------------------------
# Web search via Serper (free tier at https://serper.dev). Without it the
# researcher falls back to http_request only.
SERPER_API_KEY=

# --- Optional per-agent overrides --------------------------------------
# Each one upgrades exactly one agent. Without them the agent uses MODEL.
#   researcher  → Haiku 4.5  (cheap+fast tool calls)
#   analyst     → Sonnet 4.6 (Pydantic schema fidelity)
#   editor      → Opus 4.7   (1M context for full upstream dump)
RESEARCHER_MODEL=
ANALYST_MODEL=
EDITOR_MODEL=

# --- Optional observability (uncomment to enable) ----------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=strands-template
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental,gen_ai_tool_definitions
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
